# Copy to deploy/.env. This file is used by Docker Compose and must stay private.
# Use the existing platform database; users, logs and daily summaries must share it.
# When PostgreSQL runs on the Docker host, use host.docker.internal instead of 127.0.0.1.
SQL_DSN=postgres://partner_user:replace-me@host.docker.internal:5432/lynxtonapi?sslmode=disable

# Generate with: openssl rand -hex 32
# Keep the old admin PARTNER_SESSION_SECRET to preserve existing partner sessions.
PARTNER_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Nginx/Caddy on the same host terminates HTTPS and proxies to this localhost port.
PARTNER_BIND_ADDRESS=127.0.0.1
PARTNER_HTTP_PORT=8081
