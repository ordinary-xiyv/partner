# Copy to .env (gitignored). Each customer site needs its own project and port.
SITE_PROJECT_NAME=lynxton-customer-example
# Match the image produced by package-image.sh. Pin a version in production.
SITE_IMAGE_NAME=lynxton-partner-web-user
SITE_IMAGE_TAG=latest
SITE_ID=site-example
SITE_DOMAIN=site.example.com
# Paste the 64-character lowercase hex credential shown once in admin.
SITE_CREDENTIAL=replace-with-the-64-character-lowercase-hex-credential

# Both origins are server-to-server addresses, without a path or trailing slash.
# Production requires HTTPS with a certificate trusted by the container.
SITE_API_ORIGIN=https://user-api.example.com
SITE_PARTNER_API_ORIGIN=https://partner.example.com

# For local host services only; both services must listen on the Docker gateway.
# SITE_API_ORIGIN=http://host.docker.internal:3000
# SITE_PARTNER_API_ORIGIN=http://host.docker.internal:3004
# SITE_ALLOW_INSECURE_HTTP=true

SITE_BIND_ADDRESS=127.0.0.1
SITE_HTTP_PORT=8080
# Disable host check only for local localhost testing.
# SITE_ENFORCE_HOST=false
