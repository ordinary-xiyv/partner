# Generated at container startup; the credential never goes into the browser bundle.
server {
    listen 80 default_server;
    server_name ${SITE_DOMAIN};
    server_tokens off;
    include /etc/nginx/site-host-check.conf;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 100m;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml text/javascript image/svg+xml;
    gzip_min_length 1000;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location = /api/partner { return 404; }
    location ^~ /api/partner/ {
        return 404;
    }

    # Customer site only needs anonymous partner endpoints; do not expose the
    # partner management login or authenticated APIs on customer domains.
    location ^~ /api/partner/public/ {
        proxy_pass ${SITE_PARTNER_API_ORIGIN};
        proxy_set_header Host ${SITE_PARTNER_API_AUTHORITY};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host ${SITE_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Site-ID ${SITE_ID};
        proxy_set_header X-Site-Host ${SITE_DOMAIN};
        proxy_set_header X-Site-Credential ${SITE_CREDENTIAL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_cache off;
        proxy_read_timeout 60s;
        proxy_ssl_server_name on;
        proxy_ssl_name ${SITE_PARTNER_API_HOST};
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify on;
    }

    location ~ ^/(api|v1|swagger|readyz)(/|$) {
        proxy_pass ${SITE_API_ORIGIN};
        proxy_set_header Host ${SITE_API_AUTHORITY};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host ${SITE_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Site-ID ${SITE_ID};
        proxy_set_header X-Site-Host ${SITE_DOMAIN};
        proxy_set_header X-Site-Credential ${SITE_CREDENTIAL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 7200s;
        proxy_send_timeout 7200s;
        proxy_ssl_server_name on;
        proxy_ssl_name ${SITE_API_HOST};
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify on;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
