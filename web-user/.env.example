# 部署模式: domestic (国内版) | overseas (海外版)
# domestic: OAuth 仅支持微信登录
# overseas: OAuth 支持 GitHub, Discord, OIDC, LinuxDO, WeChat, Telegram
VITE_DEPLOY_MODE=overseas

# 后端 API 地址 (留空则使用相对路径，开发时通过 vite proxy 代理)
# VITE_API_URL=https://api.example.com

# VSCode / Vite 本地注册：复制到 web/.env.local 并填写 admin 中站点绑定信息。
# 以下变量只由 Vite 开发代理读取，不得改成 VITE_ 前缀。
# USER_SITE_ID=site-example
# USER_SITE_DOMAIN=site.example.com
# USER_SITE_CREDENTIAL=admin-once-shown-64-character-hex-credential
# USER_API_DEV_PROXY_TARGET=http://localhost:3000

# 对象存储连接请在管理后台「系统设置 → 对象存储」配置（无需构建时注入 OSS 参数）

# 站点默认品牌名（index.html 首屏标题与 i18n 兜底）
# VITE_DEFAULT_BRAND_NAME_ZH=灵通云
# VITE_DEFAULT_BRAND_NAME_EN=LynxTokens
