# ============================================================
#  伙伴平台前端（partner/web）环境变量
# ============================================================

# 后端 API 根地址。前后端分域名部署时填后端完整域名，如：
#   VITE_API_BASE_URL=https://partner.your-domain.com
# 留空则走同域相对路径（本地由 Vite 代理 /api → 127.0.0.1:3004）
VITE_API_BASE_URL=

# 是否使用本地 mock 数据。
#
# false —— 请求真实后端（partner/backend，默认 3004）。
#         这是本项目的默认值：伙伴后台的价值就在于操作真实商户数据，
#         默认走 mock 会让人误以为「改了品牌没生效」。
#
# true  —— 纯前端演示，不请求后端。仅在这几种情况值得开：
#          · 后端还没起，只想看界面
#          · 要演示「佣金 / 定价 / 邀请」这些后端尚未实现的页面
#            （真实模式下这些页面会提示「接口尚未实现」）
VITE_USE_MOCK=false
